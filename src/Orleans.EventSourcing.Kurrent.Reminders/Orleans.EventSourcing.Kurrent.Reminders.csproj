<Project Sdk="Microsoft.NET.Sdk">
		<PropertyGroup>
			<PackageId>Orleans.EventSourcing.Kurrent.Reminders</PackageId>
			<Authors>William Gunaratne</Authors>
			<Title>Kurrent Reminders Provider for Microsoft Orleans</Title>
			<Description>An implementation of Orleans reminders using a JournaledGrain that implements IReminderTable.</Description>
			<RootNamespace>Orleans.EventSourcing.Kurrent.Reminders</RootNamespace>
			<AnalysisLevel>latest-all</AnalysisLevel>
			<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
			<GenerateDocumentationFile>true</GenerateDocumentationFile>
			<NoWarn>$(NoWarn);OEK0001;CS0618</NoWarn>
			<!-- Track the reminder table grain's interface identity, [Version] and grain type in OrleansContracts.txt.
			     Its methods are inherited from Orleans' IReminderTable, which the manifest doesn't record, so method changes are not tracked. -->
			<EnableOrleansContractsAnalyzer>true</EnableOrleansContractsAnalyzer>
		</PropertyGroup>
		<ItemGroup>
			<InternalsVisibleTo Include="Orleans.EventSourcing.Kurrent.Tests" />
		</ItemGroup>
		<ItemGroup>
			<PackageReference Include="KurrentDB.Client" />
			<PackageReference Include="Microsoft.Orleans.Reminders" />
			<PackageReference Include="Microsoft.Orleans.Sdk" />
			<PackageReference Include="OpenTelemetry.Api" />
		</ItemGroup>
		<ItemGroup>
		  <ProjectReference Include="..\Orleans.EventSourcing.Kurrent\Orleans.EventSourcing.Kurrent.csproj" />
		</ItemGroup>
</Project>
