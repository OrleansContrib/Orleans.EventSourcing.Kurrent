<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Tests intentionally exercise the experimental IGrainEventProvider API. -->
    <NoWarn>$(NoWarn);OEK0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Orleans.TestingHost" />
    <PackageReference Include="Microsoft.Orleans.Clustering.TestKit" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Orleans.EventSourcing.Kurrent.Reminders\Orleans.EventSourcing.Kurrent.Reminders.csproj" />
    <ProjectReference Include="..\..\src\Orleans.EventSourcing.Kurrent\Orleans.EventSourcing.Kurrent.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <!-- Microsoft.Orleans.Clustering.TestKit's net8.0 build needs System.Collections.Immutable 10.0 but does not declare the dependency. -->
    <PackageReference Include="System.Collections.Immutable" />
  </ItemGroup>
</Project>
